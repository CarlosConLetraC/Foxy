@ Test script con valores directos estables @
include "sys/out"

char mensaje[] = "¡Hola desde Foxy-lang con tipado estricto y explícito!"
int a = 40
int b = 2
function calcular_total(int precio, int impuesto) {
    return precio + impuesto
}
int resultado = calcular_total(a, b) @ 42

printf("mensaje: %s\n", mensaje) @ mensaje: ¡Hola desde Foxy-lang con tipado estricto y explícito!
printf("resultado: %d\n", resultado) @ resultado: 42
