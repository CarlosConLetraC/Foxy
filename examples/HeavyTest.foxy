Punto p = Punto()
p->x = 10
p->y = 20

printf("Punto: x=%d, y=%d\n", p->x, p->y)

@ ============================================================================
@ 7. FUNCIONES, LAMBDAS, MODO HÍBRIDO Y TUPLAS
@ ============================================================================

@ Expresión Lambda / Anónima
(int, int) sumarLambda = (int x, int y) => x + y
int res_lambda = sumarLambda(5, 10)

@ Función variádica usando el módulo nativo peektuple
function sumarMultiples(valores...) {
    number total = 0
    int total_elementos = peektuple.count(valores)
    
    for (int idx = 0; idx < total_elementos; idx++) {
        total += (number)peektuple.get(valores, idx)
    }
    return total
}

number mis_numeros[] = {1, 2, 3, 4, 5}
number suma_total = sumarMultiples((number...)mis_numeros)

@ Modo híbrido con asignación local
function procesamientoDinamico(datos...) {
    resultado_temporal = 0
    foreach (item : datos) {
        resultado_temporal += item
    }
    return resultado_temporal
}

@ ============================================================================
@ 8. MANEJO DE EXCEPCIONES (try, catch, except, final)
@ ============================================================================

try {
    int resultado_error = 10 / 0
} catch {
    println("Se capturo un error generico sin datos.")
} except (char err[]) {
    printf("Excepcion capturada con mensaje: %s\n", err)
} final {
    println("Bloque finalizado correctamente.")
}

int numeros[] = {3, 6, 9, 12, 15, 18, 21, 24, 27, 30}
for (int i = 0; i < #numeros;) {
    println(numeros[i += 2]) @ retorna valor de i, luego hace incremento especificado.
}
