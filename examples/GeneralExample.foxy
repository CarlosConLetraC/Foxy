@ Definición de un arreglo heterogéneo de tipos numéricos bajo el contenedor unificado 'number'
number nums[] = {
    true,                         @ bool (representación numérica interna: 1)
    (char)97,                     @ signed char ('a')
    (uchar)129,                   @ unsigned char
    -12,                          @ signed int por defecto
    1,                            @ signed int
    (uint)20,                     @ unsigned int
    math.pi,                      @ double (constante de librería estándar)
    (float)5.5,                   @ float de precisión simple
    (double)2.718281,             @ double de precisión doble
    (ldouble)1.414213562373095,   @ long double de alta precisión
    (short)32767,                 @ signed short
    (ushort)65535,                @ unsigned short
    (long)100,                    @ signed long
    (ulong)101,                   @ unsigned long
    (llong)9223372036854775807,   @ signed long long (INT64_MAX)
    (ullong)18446744073709551617, @ unsigned long long (UINT64_MAX)
    
    (number)123,                  @ valor numérico dinámico nativo de foxy:
                                  @ inicialmente se aloja como signed short en este caso, pero escala 
                                  @ automáticamente a ushort / int / ... / ullong si el valor desborda.
                                  @ foxy-lang se encarga de verificar el valor registrado y comprueba si
                                  @ está en el rango permitido del tipo de dato numérico de C.
                                  @ Esto puede variar según el number casteado, por lo que el subtipo
                                  @ interno inicia desde bool (0, 1) hasta ullong (UINT64_MAX)

    @ Literales con sufijos tipados nativos de foxy-lang
    4i,                           @ signed int explícito
    5ui,                          @ unsigned int explícito
    6l,                           @ signed long explícito
    7ul,                          @ unsigned long explícito
    8ll,                          @ signed long long explícito
    9ull,                         @ unsigned long long explícito
    10f,                          @ float explícito
    11d,                          @ double explícito
    12ld,                         @ long double explícito
    13n                           @ number dinámico nativo explícito
}
@@
    Al final de ese scope, foxy-lang castea todos sus valores al tipo de dato number. Sin embargo el lenguaje
    guarda en memoria el subtipo registrado.
@@

for (int i = 0; i < #nums; i++) {
    println(nums[i])
}

(int, int) sumar = (int a, int b) => a + b
printf("la suma es de: %d\n", sumar(5, 8))

float nums1[] = {5.4f, 3.1f, 9.3f}
double nums2[] = (double[])nums1 @ adiós a ciclos for para castear T[i]. . .
                                 @ foxy puede castear arreglos de un tipo a otro.

@@@
casos NO validos de casteo:

@ @ @ INICIO DE CASO 1 @ @ @
include "string"

funcion_nativa = string.format @ utilizando el modo híbrido.
uint bits[] = {4ui, 8ui, 16ui, 32ui, 128ui}
string casteoNoPermitido[] = (funcion_nativa)bits @ error. no se puede castear un tipo de dato primitivo de una variable que
                                                  @ no es explícitamente un tipo de dato foxy. Si se trabaja con arreglos, entonces
                                                  @ se utiliza:
                                                  @    ARREGLO_A ::CASTEO:: ARERGLO_B
                                                  @    DATO_PRIMITIVO_A ::CASTEO:: DATO_PRIMITIVO_B
                                                  @    CLASE_FOXY ::CASTEO:: OBJETO_INSTANCIADO
@ @ @ FIN DE CASO 1 @ @ @
@ @ @ INICIO DE CASO 2 @ @ @
include "./myDirectorioConClases/*" @ "." representa el $PWD actual en sistemas POSIX, HOME en el caso para Windows.

NombreClaseA foo1 = NombreClaseA()
NombreClaseB foo2 = NombreClaseB()
NombreClaseC foo3 = (NombreClaseA)NombreClaseB @ error, no se puede cambiar el comportamiento de una clase, ya que funciona como firma
                                               @ para definir comportamientos declarados por el desarrollador. @ @ @ FIN DE CASO 2 @ @ @
@ @ @ INICIO DE CASO 3 @ @ @
include "sys/out/printf" @ únicamente carga printf al entorno foxy-lang.
printf("esto no funciona [%T]...\n", (int)printf) @ error, no se pueden castear tipos de dato function a cualquier otro tipo de dato.
@ @ @ FIN DE CASO 3 @ @ @

@ @ @ INICIO DE CASO 4 @ @ @
include "sys/out" @ carga un dict de foxy en entorno global.
out.printf("esto no funciona [%T]...\n", (ullong)out) @ error, no se pueden castear tipos de dato dict a cualquier otro tipo de dato.
@ @ @ FIN DE CASO 4 @ @ @


@@@

class Vector3 {
    function __new(float x, y, z); @ esto en foxy es equivalente a function __new(float x, float y, float z);
                                   @ y por su puesto, es un constructor lógico.

    function __cast(dict info) {
        if (info.type == "double" && info.abstract_type == "array") @ donde info.abstract_type := "array", "dict", "class", "object", etc.
            return {(double)self.x, (double)self.y, (double)self.z}
        elseif (info.type == "int" && info.abstract_type == "array")
            return {(int)self.x, (int)self.y, (int)self.z}
    }
}

Vector3 pos = Vector3(5.3f, 8.6f, 14.7f)
double packedDouble[] = (double[])pos
int packedInt[] = (int[])pos

