foo()

@ foxy maneja los tipos de parámetros necesitando solo un tipo de dato.
function simpleAddition(number x, number y, number z) { @ igual que `function simpleAddition(number x, number y, number z)`.
    return x + y + z
} 
printf("result: %T\n", simpleAddition(5, 10, 15))

function tupleAddition(number nums...) { 
    number result = 0
    foreach (number n : nums)
        result += n
    return result
}
printf("result: %T\n", tupleAddition(5, 3.141592, 16, 123))


@ POO en foxy-lang:

class Animal {
    function __new(string name, int age) {
        self.name = name
        self.age = age
    } @ este es un constructor pero al estilo de Lua.
      @ no hay necesidad de definir `public string name` o `public int age` arriba del constructor,
      @ foxy-lang asigna automáticamente las variables como públicas una vez inicializadas.
    
    @@
    esta también es una alternativa para el código de arriba (constructor lógico):
    function __new(string name, int age); @ el programa inicializa el objeto
                                          @ usando la lógica del primer constructor.
    @@

    @@
    dado que foxy-lang asigna automáticamente las variables como públicas una vez inicializadas, podemos
    usar la siguiente sintaxis para definir variables específicas como privadas, protegidas o incluso públicas:

    function __new(string name, int age) {
        (private)self.name = name
        (private)self.age = age
    }

    function __new(string name, int age) {
        (protected)self.name = name
        (protected)self.age = age
    }
    
    function __new(string name, int age) {
        (public)self.name = name
        (public)self.age = age
    }

    @ o al estilo clásico:
    protected string name
    protected int age

    function __new(string name, int age) {
        self.name = name
        self.age = age
    }

    @ para usar un constructor lógico con modificadores de acceso, debemos seguir esta sintaxis:
    function __new((private)string name, (private)int age);
    function __new((protected)string name, (protected)int age);
    function __new((public)string name, (public)int age); @ constructor lógico por defecto utilizado
    @@

    @ para anular el comportamiento de una función en foxy-lang, debes usar la siguiente sintaxis:
    overrule function speak(string message) {
        printf("el animal dijo: %s\n", message)
    }
    @ esto le permite al programa usar la función
    @ speak por defecto si no se define un nuevo comportamiento
    @ en la clase heredada.

    function move() {
        printf("%s se movió.\n", self.name)
    }

    function __tostring() {
        return self.name
    }

    @@@
    al igual que las metatags de Lua, foxy tiene múltiples "flagged methods".
    function __cast(dict value); @ @ @ @ llamado cuando se hace casting, retornando un valor definido por el desarrollador. Donde: dict value = { abstract_type = <char[]>, type = <char[]>, value = <funcion que castina de foo.> ? NULL }
    function __tostring(); @ @ @ @ @ @ @ retorna un arreglo de char (no un string).
    function __add(DATATYPE value);@ @ @ llamado cuando se usa el operador aritmético '+'. Ejemplo: A + B
    function __sub(DATATYPE value);@ @ @ llamado cuando se usa el operador aritmético '-'. Ejemplo: A - B
    function __mul(DATATYPE value);@ @ @ llamado cuando se usa el operador aritmético '*'. Ejemplo: A * B
    function __div(DATATYPE value);@ @ @ llamado cuando se usa el operador aritmético '/'. Ejemplo: A / B
    function __pow(DATATYPE value);@ @ @ llamado cuando se usa el operador aritmético '**'. Ejemplo: A ** B
    function __mod(DATATYPE value);@ @ @ llamado cuando se usa el operador aritmético '%'. Ejemplo: A % B
    function __unm(DATATYPE value);@ @ @ llamado cuando se usa el operador unario '-'. Ejemplo: -A
    function __not(DATATYPE value);@ @ @ llamado cuando se usa el operador lógico '!'. Ejemplo: !A
    function __eq(DATATYPE value); @ @ @ llamado cuando se usa el operador lógico '=='. Ejemplo: A == B
    function __neq(DATATYPE value);@ @ @ llamado cuando se usa el operador lógico '!='. Ejemplo: A != B
    function __lt(DATATYPE value); @ @ @ llamado cuando se usa el operador lógico '<'. Ejemplo: A > B
    function __gt(DATATYPE value); @ @ @ llamado cuando se usa el operador lógico '>'. Ejemplo: A < B
    function __le(DATATYPE value); @ @ @ llamado cuando se usa el operador lógico '<='. Ejemplo: A <= B
    function __ge(DATATYPE value); @ @ @ llamado cuando se usa el operador lógico '>='. Ejemplo: A >= B
    function __band(DATATYPE value); @ @ llamado cuando se usa el operador a nivel de bits '&'. Ejemplo: A & B
    function __bor(DATATYPE value);@ @ @ llamado cuando se usa el operador a nivel de bits '|'. Ejemplo: A | B
    function __bnot(); @ @ @ @ @ @ @ @ @ llamado cuando se usa el operador a nivel de bits '~'. Ejemplo: ~A
    function __bxor(DATATYPE value); @ @ llamado cuando se usa el operador a nivel de bits '^'. Ejemplo: A ^ B
    function __lshift(DATATYPE value); @ llamado cuando se usa el operador a nivel de bits '<<'. Ejemplo: A << B
    function __rshift(DATATYPE value); @ llamado cuando se usa el operador a nivel de bits '>>'. Ejemplo: A >> B
    function __foreach(dict value);@ @ @ llamado cuando se itera en un objeto instanciado de la clase mediante el ciclo 'foreach'.
    function __closed() @ llamado cuando el ámbito actual de foxy-lang se cierra (recolector de basura).
    function __len() @ llamado cuando se usa el operador de longitud '#'. Ejemplo: #A

    para mejorar el rendimiento, foxy-lang no sobrecarga todos estos métodos al instanciar, el
    desarrollador es el único que puede crear un método marcado.

    por ahora, string es la única clase del sistema que tiene algunos flagged methods definidos en C.
    @@@
}

class Cat from Animal {
    function __new(string name, int age) {
        super(name, age)
        self.type = "cat"
    }

    @ ahora, para anular el comportamiento de 'speak':
    function speak(string message) {
        printf("[%s]%s dijo: %s\n", self.type, self.name, message)
    }
}

class Dog from Animal {
    function __new(string name, int age); @ usa el constructor de la superclase por defecto. Nótese que 'Dog' no tiene
                                          @ un miembro llamado 'type' como 'Cat'.
}

Animal creature = Animal("Creature", 5)
Cat feline = Cat("Felix", 3)
Dog canine = Dog("Max", 2)

creature.move()
feline.move()
canine.move()

printf("%T dice: ", creature)
creature.speak("saludos")

printf("%T dice: ", feline)
feline.speak("miau")

printf("%T dice: ", canine)
canine.speak("guau")
@ creature y canine tienen el mismo comportamiento en el método 'speak'.


@@@
¡foxy-lang soporta estructuras como en C!, destinadas a mejorar el rendimiento
en datos masivos. Útil para hacer una Lista de Nodos.
@@@

struct Node {
    int data
    struct Node next
}

struct List {
    Node head
}

function createNode(int value) {
    Node newNode = Node()
    newNode->data = value
    newNode->next = NULL
    return newNode
}

function createList() {
    List newList = List()
    newList->head = NULL
    return newList
}

function insertToStart(List l, int value) {
    Node newNode = createNode(value)
    newNode->next = l->head
    l->head = newNode 
}

function insertToEnd(List l, int value) {
    Node newNode = createNode(value)
    if (!l->head) {
        l->head = newNode
        return
    }
    Node currentNode
    for (currentNode = l->head; currentNode->next != NULL; currentNode = currentNode->next);
    currentNode->next = newNode
}

function insertIntoPosition(List l, int value, position) { @ permitido, foxy-lang hace cast de position como int debido a la expresión anterior.
    if (position <= 0 || !l->head) @ se activa si position es menor a 0 o l->head == NULL
        return insertToStart(l, value) @ foxy-lang puede hacer cast de funciones void para que no retornen nada.
    
    Node currentNode = l->head
    for (int i = 0; currentNode && i < position-1; ++i)
        currentNode = currentNode->next
    
    if (!currentNode) return

    Node newNode = createNode(value)
    newNode->next = currentNode->next
    currentNode->next = newNode
}

function showList(List l) {
    for (Node currentNode = l->head; currentNode != NULL; currentNode = currentNode->next)
        printf("%d%s", currentNode->data, currentNode->next ? " -> " : "\n");
}

List moreNumbers = createList()

insertToEnd(moreNumbers, 10)
insertToEnd(moreNumbers, 20)
showList(moreNumbers)

insertToStart(moreNumbers, 5)
showList(moreNumbers)

insertIntoPosition(moreNumbers, 15, 2)
showList(moreNumbers)

insertToEnd(moreNumbers, 30)
showList(moreNumbers)


@ a diferencia de C/C++, C#, Java, Go y Rust: foxy-lang no necesita una función main para ejecutarse.


@@
breve ejemplo de sentencias goto.
@@

int waves = 0
<myLabel> {
    for (int i = 0; i < 10; i++)
        printf("[%d]: %s\n", i, i%2 ? "par" : "impar")
}

if (waves < 10) goto myLabel
else goto anotherLabel

<anotherLabel> println("¡Funciona bien!")

@@
foxy-lang puede usar 2 tipos de etiquetas goto, la primera es útil para
trabajar cuando necesitas acotar variables localmente. Así el programa puede
limpiar tipos de dato abstracto en el tiempo de ejecución.
@@


@ Manejando errores en foxy:
try {
    printf("Palabra %s\n", "hola" + println )
} catch {
    println("Esto ejecuta, pero no se sabe el motivo.")
@ aqui pueden ir más catch si son necesarios. . . @
} except (char mensaje_error[]) { @ tambien se puede usar string mensaje_error.
    printf("Motivo de error de ejecución: %s\n", mensaje_error)
} final {
    println("Esto siempre ejecuta sin importar si hubo error o no.")
}